#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"
if command -v python3 >/dev/null 2>&1; then
  exec python3 -m depth_video "$@"
fi
if command -v python >/dev/null 2>&1; then
  exec python -m depth_video "$@"
fi
echo "Python 3 is required but was not found (tried python3 and python)." >&2
exit 127
